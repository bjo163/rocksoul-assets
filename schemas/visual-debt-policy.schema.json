{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocksoul.dev/schemas/visual-debt-policy/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "schemaVersion",
    "ratchet",
    "metrics",
    "changedFileStrictness"
  ],
  "properties": {
    "contractId": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "ratchet": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "severity",
          "ceiling",
          "target",
          "owner",
          "remediationIssue"
        ]
      }
    },
    "changedFileStrictness": {
      "type": "object"
    },
    "$schema": {
      "type": "string"
    },
    "$id": {
      "type": "string"
    }
  }
}
