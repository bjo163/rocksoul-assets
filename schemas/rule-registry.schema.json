{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocksoul.dev/schemas/rule-registry/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "schemaVersion",
    "rules"
  ],
  "properties": {
    "contractId": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ruleId",
          "source",
          "normativeText",
          "owner",
          "severity",
          "enforcementType",
          "validator",
          "fixtures",
          "affectedPacks",
          "affectedSurfaces",
          "exceptionEligible",
          "status"
        ]
      }
    }
  }
}
