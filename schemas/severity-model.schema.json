{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocksoul.dev/schemas/severity-model/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "schemaVersion",
    "levels"
  ],
  "properties": {
    "contractId": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "levels": {
      "type": "object",
      "required": [
        "BLOCKER",
        "ERROR",
        "DEBT",
        "WARNING",
        "INFO"
      ],
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
