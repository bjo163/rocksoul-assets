{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocksoul.dev/schemas/golden-corpus/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "schemaVersion",
    "seed",
    "dimensions",
    "scenarios",
    "invalid",
    "scaleVariants",
    "i18nStress"
  ],
  "properties": {
    "contractId": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "seed": {
      "type": "integer"
    },
    "dimensions": {
      "type": "object"
    },
    "scenarios": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "entity",
          "epistemic",
          "trust",
          "health",
          "process",
          "change",
          "provenance",
          "time",
          "attention",
          "representations"
        ]
      }
    },
    "invalid": {
      "type": "array",
      "minItems": 5
    },
    "scaleVariants": {
      "type": "object"
    },
    "i18nStress": {
      "type": "object"
    }
  }
}
