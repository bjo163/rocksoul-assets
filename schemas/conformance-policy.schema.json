{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocksoul.dev/schemas/conformance-policy/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "schemaVersion",
    "profiles",
    "manualGatePolicy",
    "exactShaRequired"
  ],
  "properties": {
    "contractId": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "profiles": {
      "type": "object",
      "required": [
        "FULL",
        "QUALIFIED",
        "EXPERIMENTAL",
        "NONCONFORMANT"
      ]
    },
    "manualGatePolicy": {
      "type": "object"
    },
    "exactShaRequired": {
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    },
    "$id": {
      "type": "string"
    }
  }
}
