{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocksoul.dev/schemas/visual-token-contract/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "schemaVersion",
    "visualSystemVersion",
    "primitives",
    "semantics",
    "presentationAliases",
    "surfacePersonalities"
  ],
  "properties": {
    "contractId": {
      "const": "visual.tokens.v2"
    },
    "schemaVersion": {
      "const": 1
    },
    "visualSystemVersion": {
      "const": 2
    },
    "status": {
      "type": "string"
    },
    "compatibility": {
      "type": "object"
    },
    "primitives": {
      "type": "object"
    },
    "semantics": {
      "type": "object"
    },
    "presentationAliases": {
      "type": "object"
    },
    "typographyRoles": {
      "type": "object"
    },
    "density": {
      "type": "object"
    },
    "surfacePersonalities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "semanticInventories": {
      "type": "object"
    },
    "$schema": {
      "type": "string"
    },
    "$id": {
      "type": "string"
    },
    "lifecyclePolicy": {
      "type": "object"
    }
  }
}
