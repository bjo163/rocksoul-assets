{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocksoul.dev/schemas/ai-contribution-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskIssueId",
    "contributorMode",
    "changedCanonicalPaths",
    "generatedPaths",
    "changedSemanticIds",
    "changedRuleIds",
    "impactReport",
    "validationCommands",
    "visualBaselinesAffected",
    "waiversChanged",
    "manualGatesRequired",
    "provenanceEntries"
  ],
  "properties": {
    "taskIssueId": {
      "type": "string"
    },
    "contributorMode": {
      "enum": [
        "local-ai",
        "0dev",
        "agent",
        "generator",
        "mixed"
      ]
    },
    "changedCanonicalPaths": {
      "type": "array"
    },
    "generatedPaths": {
      "type": "array"
    },
    "changedSemanticIds": {
      "type": "array"
    },
    "changedRuleIds": {
      "type": "array"
    },
    "impactReport": {
      "type": "string"
    },
    "validationCommands": {
      "type": "array"
    },
    "visualBaselinesAffected": {
      "type": "array"
    },
    "waiversChanged": {
      "type": "array"
    },
    "manualGatesRequired": {
      "type": "array"
    },
    "provenanceEntries": {
      "type": "array"
    },
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "sourceContracts": {
      "type": "array"
    },
    "debtImpact": {
      "type": "string"
    },
    "approvalState": {
      "type": "string"
    },
    "hiddenReasoningStored": {
      "type": "boolean"
    }
  }
}
