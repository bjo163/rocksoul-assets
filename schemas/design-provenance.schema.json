{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocksoul.dev/schemas/design-provenance/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "schemaVersion",
    "coverage",
    "entries"
  ],
  "properties": {
    "contractId": {
      "const": "provenance.design.v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "coverage": {
      "type": "object"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provenanceId",
          "stableId",
          "sourcePath",
          "kind",
          "semanticOwner",
          "grammarFamily",
          "lifecycle",
          "authoredMode",
          "authorizedBy",
          "rationale",
          "sourceSha256"
        ]
      }
    }
  }
}
