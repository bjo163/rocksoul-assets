{
  "name": "rocksoul-assets",
  "private": true,
  "type": "module",
  "scripts": {
    "test:release": "node --test tests/release/*.test.mjs",
    "validate:release": "node tools/release/validate-release.mjs",
    "validate:registry": "node tools/assets/validate-registry-integrity.mjs",
    "validate:generation": "node tools/generation/validate-freshness.mjs",
    "validate:todo": "node tools/todo/validate-evidence.mjs",
    "validate:contract": "node scripts/validate-rocksoul-contract.mjs",
    "audit:visual-v2": "node tools/assets/generate-visual-system-v2-audit.mjs --write",
    "validate:visual-v2": "node tools/assets/validate-visual-system.mjs",
    "migrate:visual-v2": "python tools/assets/generate_visual_system_v2_migration.py",
    "validate:migration:visual-v2": "python tools/assets/generate_visual_system_v2_migration.py --check"
  }
}
