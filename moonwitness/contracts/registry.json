  "patternRegistrations": [
    {
      "pattern": "moonwitness/*/manifest.json",
      "schemaId": "asset-manifest",
      "owner": "pack-owner",
      "stability": "stable"
    },
    {
      "pattern": "moonwitness/*/*-pack.json",
      "schemaId": "asset-manifest",
      "owner": "pack-owner",
      "stability": "stable"
    },
    {
      "pattern": "moonwitness/*/png/manifest.json",
      "schemaId": "generated-raster-manifest",
      "owner": "generator",
      "stability": "generated"
    },
    {
      "pattern": "moonwitness/*/generated/manifest.json",
      "schemaId": "generated-asset-manifest",
      "owner": "generator",
      "stability": "generated"
    },
    {
      "pattern": "moonwitness/ui/v2/*.json",
      "schemaId": "ui-v2-contract",
      "owner": "ui-reference",
      "stability": "stable"
    },
    {
      "pattern": "moonwitness/*/*.json",
      "schemaId": "asset-catalog",
      "owner": "pack-owner",
      "stability": "stable"
    },
    {
      "pattern": "moonwitness/*/*/*.json",
      "schemaId": "generated-or-nested-catalog",
      "owner": "generator-or-pack-owner",
      "stability": "generated"
    }
  ]
}
