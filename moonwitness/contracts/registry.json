{
  "$schema": "../../schemas/contract-registry.schema.json",
  "contractId": "contracts.registry.v1",
  "schemaVersion": 1,
  "compatibility": {
    "PATCH": "descriptive or additive metadata only",
    "MINOR": "additive semantic IDs or backwards-compatible fields",
    "MAJOR": "removed meaning, incompatible shape, semantic reinterpretation"
